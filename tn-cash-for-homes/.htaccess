# BEGIN Tennessee Cash For Homes — Migration 301 Redirects
# Wix → WordPress URL migration. Place this file at the WordPress install root
# (NOT inside the theme folder). It is checked into the theme for source control.
#
# Rules are evaluated top-to-bottom. The order matters: more-specific paths
# (e.g. /sell-your-land-1) must come before broader patterns that could shadow
# them (e.g. /sell-your-land*).
<IfModule mod_rewrite.c>
RewriteEngine On

# ── 1. Wix legacy slug normalizations ────────────────────────────────────
# Old Wix internal nav linked to /sell-your-land — site URL is /sell-your-land-1.
# Anyone with the un-numbered link should land on the canonical page.
RewriteRule ^sell-your-land/?$ /sell-your-land-1/ [R=301,L]
RewriteRule ^sell-my-land/?$ /sell-your-land-1/ [R=301,L]

# /investors-lenders is the WP template label; Wix shipped /investors. Both
# should resolve to the canonical /investors/ page.
RewriteRule ^investors-lenders/?$ /investors/ [R=301,L]
RewriteRule ^investors-and-lenders/?$ /investors/ [R=301,L]

# ── 2. Wix-only top-level pages with no WP equivalent ────────────────────
RewriteRule ^our-solutions/?$ /how-it-works/ [R=301,L]
RewriteRule ^more-information/?$ /about/ [R=301,L]
RewriteRule ^privacy-policy-ppc/?$ /privacy-policy/ [R=301,L]
RewriteRule ^terms-of-service-ppc/?$ /privacy-policy/ [R=301,L]

# ── 3. Wix /items archive + 17 SEO landing pages ─────────────────────────
# These were Wix dynamic-collection pages on foreclosure/probate/bankruptcy
# topics. The closest WP equivalent is the foreclosure landing flow.
RewriteRule ^items/?$ /facing-foreclosure/ [R=301,L]
RewriteRule ^items/.+$ /facing-foreclosure/tennessee/ [R=301,L]

# ── 4. Wix /post/<slug> blog posts → WP /<slug>/ (104 posts) ─────────────
# Single regex replaces what would otherwise be 100+ explicit RedirectMatch
# rules. The post slug is preserved 1:1 — confirmed against redirects.csv.
RedirectMatch 301 ^/post/(.+?)/?$ /$1/

</IfModule>
# END Tennessee Cash For Homes — Migration 301 Redirects

# BEGIN Tennessee Cash For Homes — Static Asset Caching
# Long-lived cache headers for fingerprinted/versioned static assets.
# WordPress appends ?ver=<filemtime> to enqueued CSS/JS so a cache hit is
# safe — any change bumps the query string and forces a re-fetch.
<IfModule mod_expires.c>
  ExpiresActive On
  # Images: 1 year (most browsers cap CDN cache at this length)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon  "access plus 1 year"
  # Fonts: 1 year (self-hosted Poppins woff2)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff  "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  # CSS and JS: 1 year (versioned via WP ?ver= query string)
  ExpiresByType text/css        "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  # HTML: short, to keep dynamic WP pages fresh
  ExpiresByType text/html "access plus 0 seconds"
  # Default fallback
  ExpiresDefault "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Mark static assets immutable so revalidation requests are skipped.
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML stays revalidated.
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
# END Tennessee Cash For Homes — Static Asset Caching

# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
